root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
# ConfigureAwait is unnecessary in ASP.NET Core (no SynchronizationContext).
dotnet_diagnostic.MA0004.severity = none
# Several related types per file are intentional in this codebase (e.g. Entities.cs).
dotnet_diagnostic.MA0048.severity = none

[**/Migrations/*.cs]
# EF Core generated migrations are not hand-maintained.
generated_code = true
dotnet_diagnostic.MA0051.severity = none
